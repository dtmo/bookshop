<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd
                        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.6.xsd
                        ">
    <changeSet id="1" author="">
        <createTable tableName="user">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_user" nullable="false"
                    unique="true" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addAutoIncrement tableName="user" columnName="id" />

        <createTable tableName="account">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_account" nullable="false"
                    unique="true" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addAutoIncrement tableName="account" columnName="id" />

        <createTable tableName="user_accounts">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_user_accounts" nullable="false"
                    unique="true" />
            </column>
            <column name="user_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="user"
                    referencedColumnNames="id" foreignKeyName="fk_user_accounts_user_id" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="account"
                    referencedColumnNames="id" foreignKeyName="fk_user_accounts_account_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="user_accounts" columnName="id" />

        <createTable tableName="product">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_product" nullable="false"
                    unique="true" />
            </column>
            <column name="price" type="number">
                <constraints nullable="false" />
            </column>
            <column name="stock_keeping_unit" type="varchar">
                <constraints nullable="false" unique="true" />
            </column>
        </createTable>

        <addAutoIncrement tableName="product" columnName="id" />

        <createTable tableName="shopping_basket_line_item">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_shopping_basket_line_item"
                    nullable="false"
                    unique="true" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="account"
                    referencedColumnNames="id"
                    foreignKeyName="fk_shopping_basket_line_item_account_id" />
            </column>
            <column name="product_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="product"
                    referencedColumnNames="id"
                    foreignKeyName="fk_shopping_basket_line_item_product_id" />
            </column>
            <column name="quantity" type="number">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addAutoIncrement tableName="shopping_basket_line_item" columnName="id" />

        <createTable tableName="payment_card">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_payment_card" nullable="false"
                    unique="true" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="cardholder_name" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="card_number" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="expiry" type="date">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="account"
                    referencedColumnNames="id" foreignKeyName="fk_payment_card_account_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="payment_card" columnName="id" />

        <createTable tableName="order">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_order" nullable="false"
                    unique="true" />
            </column>
            <column name="creation_time" type="timestamp">
                <constraints nullable="false" />
            </column>
            <column name="payment_card_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="payment_card"
                    referencedColumnNames="id" foreignKeyName="fk_order_payment_card_id" />
            </column>
            <column name="order_state" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="account"
                    referencedColumnNames="id" foreignKeyName="fk_payment_card_account_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="order" columnName="id" />

        <createTable tableName="order_line_item">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_order_line_item" nullable="false"
                    unique="true" />
            </column>
            <column name="order_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="order"
                    referencedColumnNames="id" foreignKeyName="fk_order_line_item_order_id" />
            </column>
            <column name="product_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="product"
                    referencedColumnNames="id" foreignKeyName="fk_order_line_item_product_id" />
            </column>
            <column name="quantity" type="number">
                <constraints nullable="false" />
            </column>
            <column name="unit_price" type="number">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addAutoIncrement tableName="order_line_item" columnName="id" />

        <createTable tableName="author">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_author" nullable="false"
                    unique="true" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="alias" type="varchar" />
        </createTable>

        <addAutoIncrement tableName="author" columnName="id" />

        <createTable tableName="book">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_book" nullable="false"
                    unique="true" />
            </column>
            <column name="product_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="product"
                    referencedColumnNames="id" foreignKeyName="fk_book_product_id" />
            </column>
            <column name="title" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="production_credits" type="varchar" />
            <column name="summary" type="text" />
            <column name="language" type="text" />
            <column name="subject" type="text" />
        </createTable>

        <addAutoIncrement tableName="book" columnName="id" />

        <createTable tableName="book_authors">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_book_authors" nullable="false"
                    unique="true" />
            </column>
            <column name="book_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="book"
                    referencedColumnNames="id" foreignKeyName="fk_book_authors_book_id" />
            </column>
            <column name="author_id" type="number">
                <constraints nullable="false" unique="true" referencedTableName="author"
                    referencedColumnNames="id" foreignKeyName="fk_book_authors_author_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="book_authors" columnName="id" />
    </changeSet>
</databaseChangeLog>