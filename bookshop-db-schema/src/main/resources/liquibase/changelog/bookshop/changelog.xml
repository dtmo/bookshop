<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd
                        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.6.xsd
                        ">
    <changeSet id="1" author="">
        <createTable tableName="customer">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_user" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" unique="true" />
            </column>
        </createTable>

        <addAutoIncrement tableName="customer" columnName="id" />

        <createTable tableName="account">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_account" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" unique="true" />
            </column>
        </createTable>

        <addAutoIncrement tableName="account" columnName="id" />

        <createTable tableName="account_customers">
            <column name="customer_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_account_customers"
                    referencedTableName="customer" referencedColumnNames="id"
                    foreignKeyName="fk_account_customers_customer_id" />
            </column>
            <column name="account_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_account_customers"
                    referencedTableName="account" referencedColumnNames="id"
                    foreignKeyName="fk_account_customers_account_id" />
            </column>
        </createTable>

        <createTable tableName="book">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_book" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="price" type="number">
                <constraints nullable="false" />
            </column>
            <column name="stock_keeping_unit" type="varchar">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="title" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="production_credits" type="varchar" />
            <column name="summary" type="text" />
            <column name="language" type="text" />
            <column name="subject" type="text" />
        </createTable>

        <addAutoIncrement tableName="book" columnName="id" />

        <createTable tableName="shopping_basket_item">
            <column name="account_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_shopping_basket_item"
                    referencedTableName="account" referencedColumnNames="id"
                    foreignKeyName="fk_shopping_basket_item_account_id" />
            </column>
            <column name="book_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_shopping_basket_item"
                    referencedTableName="book" referencedColumnNames="id"
                    foreignKeyName="fk_shopping_basket_item_book_id" />
            </column>
            <column name="quantity" type="number">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="payment_card">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_payment_card" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="cardholder_name" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="card_number" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="expiry" type="date">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" referencedTableName="account"
                    referencedColumnNames="id" foreignKeyName="fk_payment_card_account_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="payment_card" columnName="id" />

        <createTable tableName="in_progress_order">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_in_progress_order" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="payment_card_id" type="number">
                <constraints nullable="false" referencedTableName="payment_card"
                    referencedColumnNames="id" foreignKeyName="fk_in_progress_order_payment_card_id" />
            </column>
            <column name="order_state" type="varchar">
                <constraints nullable="false" />
            </column>
            <column name="account_id" type="number">
                <constraints nullable="false" referencedTableName="account"
                    referencedColumnNames="id" foreignKeyName="fk_payment_card_account_id" />
            </column>
        </createTable>

        <addAutoIncrement tableName="in_progress_order" columnName="id" />

        <createTable tableName="in_progress_order_line_item">
            <column name="in_progress_order_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_in_progress_order_line_item"
                    referencedTableName="in_progress_order" referencedColumnNames="id"
                    foreignKeyName="fk_in_progress_order_line_item_in_progress_order_id" />
            </column>
            <column name="book_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_in_progress_order_line_item"
                    referencedTableName="book" referencedColumnNames="id"
                    foreignKeyName="fk_in_progress_order_line_item_book_id" />
            </column>
            <column name="quantity" type="number">
                <constraints nullable="false" />
            </column>
            <column name="unit_price" type="number">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createTable tableName="author">
            <column name="id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_author" />
            </column>
            <column name="creation_time" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addAutoIncrement tableName="author" columnName="id" />

        <createTable tableName="book_authors">
            <column name="author_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_book_authors"
                    referencedTableName="author" referencedColumnNames="id"
                    foreignKeyName="fk_book_authors_author_id" />
            </column>
            <column name="book_id" type="number">
                <constraints primaryKey="true" primaryKeyName="pk_book_authors"
                    referencedTableName="book" referencedColumnNames="id"
                    foreignKeyName="fk_book_authors_book_id" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>