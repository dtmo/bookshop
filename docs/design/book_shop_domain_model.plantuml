@startuml

abstract class Product {
    String stockKeepingUnit
    long price
}

' Based on Project Gutenberg agent
class Author {
    String name
    String alias
    LocalDate birthdate
}

class Book {
    String title
    ' https://www.loc.gov/marc/bibliographic/bd508.html
    String productionCredits
    ' https://www.loc.gov/marc/bibliographic/bd520.html
    String summary
    String language
    String subject
}

Product <|-- Book
Book "*" --> "authors 1..*" Author

class OrderLineItem {
    int quantity
}

OrderLineItem "*" --> "item 1" Product

class ShoppingBasket {
    addItem(Product product)
    removeItem(OrderLineItem orderLineItem)
    updateItemQuantity(OrderLineItem orderLineItem, int quantity)
}

ShoppingBasket "1" *--> "orderLineItems *" OrderLineItem

class PaymentCard {
    String cardNumber
    LocalDate expiryDate
}

enum OrderState {
    NEW
    PREPARING
    PREPARED
    DISPATCHED
    CANCELLED
}

class Order {
    Instant creationTimestamp
}

Order *--> "orderState 1" OrderState
Order "1" *--> "orderLineItems *" OrderLineItem
Order "*" --> "paymentCard 1" PaymentCard

class Account {
}

Account "1" --> "orders *" Order
Account "1" *--> "paymentCard *" PaymentCard

class User {
    String name
}
User "1" *--> "account 1" Account

@enduml